# 이 파일을 .env.local로 복사하고 두 공개 값을 배포 환경 값으로 바꾼다.
# Flutter 3.44 이상은 --dart-define-from-file=.env.local 옵션으로 이 .env
# 형식을 읽을 수 있다. 서버 전용 인증 정보는 절대 여기에 추가하지 않는다.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-me
# 초대 링크에 사용할 선택적 공개 HTTPS 출처다. 일회성 코드만 공유하려면
# 비워 두고, Supabase API URL이나 추측한 호스트를 대신 넣지 않는다.
INVITE_BASE_URL=
