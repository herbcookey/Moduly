# Copy this file to .env.local and replace both public values with the
# deployment values. Flutter 3.44+ accepts this .env format with
# --dart-define-from-file=.env.local. Never add server-only credentials here.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-me
# Optional public HTTPS origin for invite links. Leave empty to share the
# one-shot code only; do not substitute the Supabase API URL or a guessed host.
INVITE_BASE_URL=
