<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 운영 환경에서 Supabase Auth와 일정 API는 원격 서비스다. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13 이상의 로컬 미리 알림용 런타임 권한이다. Flutter 어댑터는
         사용자가 알림 켜기를 누른 뒤에만 이 권한을 요청한다. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 기기 재부팅 후 로컬 스케줄러가 범위가 제한된 미리 알림 구간을 복원하는 데
         필요하다. 정확한 알람 권한은 의도적으로 요청하지 않으며, 미리 알림은
         inexactAllowWhileIdle을 사용한다. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <application
        android:label="Moduly"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Android 프로세스가 시작되자마자 이 Activity에 적용할 테마다.
                 Flutter UI가 초기화되는 동안 사용자에게 보이며, 이후에도
                 Flutter UI 뒤의 Window 배경을 결정한다. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- app_links가 네이티브 콜백 전달을 담당하므로 충돌하는 Flutter의
                 기본 딥 링크 라우트 처리를 비활성화한다. -->
            <meta-data
              android:name="flutter_deeplinking_enabled"
              android:value="false" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Supabase 이메일 확인 및 비밀번호 복구 링크다. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="moduly"
                    android:host="auth-callback" />
            </intent-filter>
            <!-- 초대 링크는 별도 호스트를 사용하므로 Supabase 인증 콜백의
                 intent-filter 데이터와 섞이지 않는다. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="moduly"
                    android:host="invite" />
            </intent-filter>
        </activity>
        <!-- 아래 메타데이터를 삭제하지 않는다.
             Flutter 도구가 GeneratedPluginRegistrant.java를 생성할 때 사용한다. -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- flutter_local_notifications의 예약 전달 receiver다. 외부에 노출되지
             않으며 이 앱이 만든 알람만 처리한다. -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver"
            android:exported="false" />
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
    </application>
    <!-- 텍스트를 처리할 수 있는 Activity를 조회하는 데 필요하다. 자세한 내용은
         https://developer.android.com/training/package-visibility 및
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         특히 Flutter 엔진의 io.flutter.plugin.text.ProcessTextPlugin에서 사용한다. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
