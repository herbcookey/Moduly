<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 운영 환경에서 Supabase Auth와 일정 API는 원격 서비스다. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <application
        android:label="Moduly"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Android 프로세스가 시작되자마자 이 Activity에 적용할 테마다.
                 Flutter UI가 초기화되는 동안 사용자에게 보이며, 이후에도
                 Flutter UI 뒤의 Window 배경을 결정한다. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- app_links owns native callback delivery; disable Flutter's
                 competing default deep-link route handling. -->
            <meta-data
              android:name="flutter_deeplinking_enabled"
              android:value="false" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Supabase 이메일 확인 및 비밀번호 복구 링크다. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="moduly"
                    android:host="auth-callback" />
            </intent-filter>
            <!-- Invite links use a separate host so they never get mixed with
                 the Supabase auth callback's intent-filter data. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="moduly"
                    android:host="invite" />
            </intent-filter>
        </activity>
        <!-- 아래 메타데이터를 삭제하지 않는다.
             Flutter 도구가 GeneratedPluginRegistrant.java를 생성할 때 사용한다. -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- 텍스트를 처리할 수 있는 Activity를 조회하는 데 필요하다. 자세한 내용은
         https://developer.android.com/training/package-visibility 및
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         특히 Flutter 엔진의 io.flutter.plugin.text.ProcessTextPlugin에서 사용한다. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
