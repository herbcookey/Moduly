// Runner 대상의 앱 수준 설정이다.
//
// 나중에 메타데이터(예: pubspec.yaml)에서 자동 생성된 값으로 대체할 수
// 있다. 그렇지 않으면 'flutter create' 템플릿이 될 때 아래 값은 프로젝트
// 이름을 기본값으로 사용한다.

// 앱 이름이다. 기본적으로 Flutter 창 제목이기도 하다.
PRODUCT_NAME = Moduly

// 앱의 번들 식별자다.
PRODUCT_BUNDLE_IDENTIFIER = com.herbcookey.moduly

// 앱 정보에 표시할 저작권 문구다.
PRODUCT_COPYRIGHT = Copyright © 2026 com.example. All rights reserved.
